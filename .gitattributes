# 行尾符规范化 - 统一使用 LF
*.php    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.txt    text eol=lf
*.dist   text eol=lf
*.ini    text eol=lf
*.neon   text eol=lf

# 二进制文件 - 不做 diff/merge 尝试
*.phar   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.so     binary
*.dll    binary
*.exe    binary
*.sqlite binary
*.db     binary

# GitHub linguist 语言统计
vendor/*        linguist-vendored
*.min.js        linguist-generated
*.min.css       linguist-generated
phpunit.xml     linguist-detectable

# 导出过滤 - git archive 时排除
.gitignore      export-ignore
.gitattributes  export-ignore
.phpunit.cache  export-ignore
*.log           export-ignore
vector_store/*  export-ignore

# 合并策略 - lock 文件自动使用 ours
composer.lock   merge=ours